# Any one key is enough. Providers are tried in this order; missing keys are skipped.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides
# LLM_ORDER=groq,groq-fast,gemini,openrouter
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_TIMEOUT_MS=20000
